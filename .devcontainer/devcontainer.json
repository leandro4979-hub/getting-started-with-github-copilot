{
  "name": "Python 3",
  "image": "mcr.microsoft.com/devcontainers/python:3.13",
  "forwardPorts": [8000],
  "postStartCommand": "[ -f requirements.txt ] && python -m pip install -r requirements.txt || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "GitHub.copilot-chat",
        "GitHub.copilot"
      ]
    }
  }
}
